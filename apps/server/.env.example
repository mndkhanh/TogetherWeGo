# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug

# Public URL of the web app (used for redirects and Origin checks)
APP_ORIGIN=http://localhost:5173

# Local docker compose stack (pnpm db:up)
DATABASE_URL=postgresql://twg:twg@localhost:5432/togetherwego
REDIS_URL=redis://localhost:6380

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, defaults to $APP_ORIGIN/v1/auth/google/callback
# GOOGLE_REDIRECT_URI=

// Phase 0 schema: identity only. Groups, expenses, settlements etc. come in later phases.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  VND
  USD
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  /// Argon2id hash. Null for Google-only accounts.
  passwordHash    String?   @map("password_hash")
  /// Google account subject (`sub` claim). Null if Google is not linked.
  googleSub       String?   @unique @map("google_sub")
  name            String
  avatarKey       String?   @map("avatar_key")
  defaultCurrency Currency  @default(VND) @map("default_currency")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
/// All tokens issued from one login share a `familyId`; reuse of a rotated
/// token revokes the whole family (token theft detection).
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Identity (phase 0), groups (phase 1), expenses (phase 2), settling up (phase 3), events (phase 4).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  VND
  USD
}

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  email           String   @unique
  /// Argon2id hash. Null for Google-only accounts.
  passwordHash    String?  @map("password_hash")
  /// Google account subject (`sub` claim). Null if Google is not linked.
  googleSub       String?  @unique @map("google_sub")
  name            String
  avatarKey       String?  @map("avatar_key")
  defaultCurrency Currency @default(VND) @map("default_currency")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens   RefreshToken[]
  memberships     GroupMember[]
  createdGroups   Group[]            @relation("GroupCreator")
  createdInvites  GroupInvite[]
  paidExpenses    Expense[]          @relation("ExpensePayer")
  createdExpenses Expense[]          @relation("ExpenseCreator")
  expenseSplits   ExpenseSplit[]
  activity        ActivityLog[]
  paymentAccount  PaymentAccount?
  paymentsSent    Settlement[]       @relation("SettlementFrom")
  paymentsGot     Settlement[]       @relation("SettlementTo")
  transfersIn     SepayTransaction[]
  createdEvents   Event[]
  rsvps           EventRsvp[]
  comments        EventComment[]

  @@map("users")
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
/// All tokens issued from one login share a `familyId`; reuse of a rotated
/// token revokes the whole family (token theft detection).
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum GroupRole {
  owner
  admin
  member
}

model Group {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  /// Default currency for the group's expenses.
  currency   Currency  @default(VND)
  createdBy  String    @map("created_by") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator     User          @relation("GroupCreator", fields: [createdBy], references: [id])
  members     GroupMember[]
  invites     GroupInvite[]
  expenses    Expense[]
  settlements Settlement[]
  events      Event[]
  activity    ActivityLog[]

  @@map("groups")
}

/// Membership rows are never deleted: leaving or being removed sets leftAt, so past
/// expenses and balances keep pointing at a real member. Rejoining clears leftAt.
model GroupMember {
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// Shareable invite links. The code is the bearer secret in the URL (/invite/<code>).
model GroupInvite {
  code      String    @id
  groupId   String    @map("group_id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Null means unlimited uses until expiry.
  maxUses   Int?      @map("max_uses")
  uses      Int       @default(0)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_invites")
}

enum SplitType {
  equal
  exact
  percent
  shares
}

/// Amounts are BIGINT minor units in the group's currency (VND: whole đồng). Never floats.
/// Deleting is soft (deletedAt) so balances can be audited. `version` is for optimistic locking.
model Expense {
  id         String    @id @default(uuid(7)) @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  payerId    String    @map("payer_id") @db.Uuid
  amount     BigInt
  currency   Currency
  title      String
  note       String?
  splitType  SplitType @map("split_type")
  /// The calendar day it was spent (no time zone).
  spentOn    DateTime  @map("spent_on") @db.Date
  receiptKey String?   @map("receipt_key")
  /// The group event it was for. A composite FK in the migration keeps it in the same group.
  eventId    String?   @map("event_id") @db.Uuid
  createdBy  String    @map("created_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group   Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer   User           @relation("ExpensePayer", fields: [payerId], references: [id])
  creator User           @relation("ExpenseCreator", fields: [createdBy], references: [id])
  event   Event?         @relation(fields: [eventId], references: [id])
  splits  ExpenseSplit[]

  @@index([groupId, spentOn(sort: Desc), id(sort: Desc)])
  @@index([eventId])
  @@map("expenses")
}

/// One row per person sharing the expense. The amounts always add up to expenses.amount
/// (checked by a deferred constraint trigger in the database, not only in the service).
model ExpenseSplit {
  expenseId String @map("expense_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  amount    BigInt
  /// What was entered: the amount (exact), basis points (percent) or shares. 1 for equal.
  value     Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

/// Append-only audit trail of changes to group data.
model ActivityLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  diff      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([groupId, createdAt])
  @@map("activity_log")
}

/// Where someone wants to be paid. One per person. The account number is personal data:
/// only the two people in a payment ever see it.
model PaymentAccount {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  /// NAPAS bank id (see BANKS in @twg/shared).
  bankBin          String    @map("bank_bin")
  accountNumber    String    @map("account_number")
  /// Capitals without accents, as banks show it.
  holderName       String    @map("holder_name")
  /// SHA-256 of the key SePay sends in `Authorization: Apikey <key>`. The key itself is
  /// shown once and never stored. Null: SePay is not set up.
  sepayKeyHash     String?   @unique @map("sepay_key_hash")
  sepayKeyHint     String?   @map("sepay_key_hint")
  sepayLastEventAt DateTime? @map("sepay_last_event_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions SepayTransaction[]

  @@map("payment_accounts")
}

enum SettlementStatus {
  pending
  confirmed
  cancelled
}

enum ConfirmedVia {
  sepay
  manual
}

/// One person paying another back. Only confirmed settlements count in balances, at
/// `paidAmount` (what actually arrived). A confirmed settlement can never change again
/// (enforced by a trigger), and settlements are never deleted.
model Settlement {
  id           String           @id @default(uuid(7)) @db.Uuid
  groupId      String           @map("group_id") @db.Uuid
  fromUserId   String           @map("from_user_id") @db.Uuid
  toUserId     String           @map("to_user_id") @db.Uuid
  amount       BigInt
  paidAmount   BigInt?          @map("paid_amount")
  currency     Currency
  paymentCode  String           @unique @map("payment_code")
  status       SettlementStatus @default(pending)
  confirmedVia ConfirmedVia?    @map("confirmed_via")
  createdBy    String           @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt  DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt  DateTime?        @map("cancelled_at") @db.Timestamptz(3)

  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from        User              @relation("SettlementFrom", fields: [fromUserId], references: [id])
  to          User              @relation("SettlementTo", fields: [toUserId], references: [id])
  transaction SepayTransaction?

  @@index([groupId, createdAt(sort: Desc)])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("settlements")
}

enum SepayTransactionStatus {
  matched
  unmatched
  ignored
}

/// Every incoming transfer SePay told us about, kept as received (it is a bank record, so
/// it outlives the payment account). The unique (payee, SePay id) pair makes webhook
/// retries harmless.
model SepayTransaction {
  id               String                 @id @default(uuid(7)) @db.Uuid
  /// The payee: whose account the money arrived in.
  userId           String                 @map("user_id") @db.Uuid
  paymentAccountId String?                @map("payment_account_id") @db.Uuid
  sepayId          BigInt                 @map("sepay_id")
  accountNumber    String                 @map("account_number")
  amount           BigInt
  content          String
  referenceCode    String?                @map("reference_code")
  transferredAt    String                 @map("transferred_at")
  raw              Json
  status           SepayTransactionStatus
  settlementId     String?                @unique @map("settlement_id") @db.Uuid
  receivedAt       DateTime               @default(now()) @map("received_at") @db.Timestamptz(3)
  resolvedAt       DateTime?              @map("resolved_at") @db.Timestamptz(3)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  settlement Settlement?     @relation(fields: [settlementId], references: [id])

  @@unique([userId, sepayId])
  @@index([userId, status, receivedAt(sort: Desc)])
  @@map("sepay_transactions")
}

enum EventStatus {
  scheduled
  cancelled
}

/// A hangout in a group. Never deleted: cancelling keeps it, with its comments and expenses.
model Event {
  id          String      @id @default(uuid(7)) @db.Uuid
  groupId     String      @map("group_id") @db.Uuid
  title       String
  description String?
  location    String?
  startsAt    DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?   @map("ends_at") @db.Timestamptz(3)
  status      EventStatus @default(scheduled)
  createdBy   String      @map("created_by") @db.Uuid
  cancelledAt DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  group    Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator  User           @relation(fields: [createdBy], references: [id])
  rsvps    EventRsvp[]
  comments EventComment[]
  expenses Expense[]

  /// Target of the (event_id, group_id) foreign key from expenses.
  @@unique([id, groupId])
  @@index([groupId, startsAt])
  @@map("events")
}

enum RsvpStatus {
  going
  maybe
  no
}

model EventRsvp {
  eventId   String     @map("event_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    RsvpStatus
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

/// Plain text only: shown escaped, never as HTML. Deleting is soft, so threads keep their shape
/// in the audit trail.
model EventComment {
  id        String    @id @default(uuid(7)) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy String?   @map("deleted_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("event_comments")
}

// Identity (phase 0), groups (phase 1) and expenses (phase 2). Settlements etc. come later.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  VND
  USD
}

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  email           String   @unique
  /// Argon2id hash. Null for Google-only accounts.
  passwordHash    String?  @map("password_hash")
  /// Google account subject (`sub` claim). Null if Google is not linked.
  googleSub       String?  @unique @map("google_sub")
  name            String
  avatarKey       String?  @map("avatar_key")
  defaultCurrency Currency @default(VND) @map("default_currency")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens   RefreshToken[]
  memberships     GroupMember[]
  createdGroups   Group[]        @relation("GroupCreator")
  createdInvites  GroupInvite[]
  paidExpenses    Expense[]      @relation("ExpensePayer")
  createdExpenses Expense[]      @relation("ExpenseCreator")
  expenseSplits   ExpenseSplit[]
  activity        ActivityLog[]

  @@map("users")
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
/// All tokens issued from one login share a `familyId`; reuse of a rotated
/// token revokes the whole family (token theft detection).
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum GroupRole {
  owner
  admin
  member
}

model Group {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  /// Default currency for the group's expenses.
  currency   Currency  @default(VND)
  createdBy  String    @map("created_by") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator  User          @relation("GroupCreator", fields: [createdBy], references: [id])
  members  GroupMember[]
  invites  GroupInvite[]
  expenses Expense[]
  activity ActivityLog[]

  @@map("groups")
}

/// Membership rows are never deleted: leaving or being removed sets leftAt, so past
/// expenses and balances keep pointing at a real member. Rejoining clears leftAt.
model GroupMember {
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// Shareable invite links. The code is the bearer secret in the URL (/invite/<code>).
model GroupInvite {
  code      String    @id
  groupId   String    @map("group_id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Null means unlimited uses until expiry.
  maxUses   Int?      @map("max_uses")
  uses      Int       @default(0)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_invites")
}

enum SplitType {
  equal
  exact
  percent
  shares
}

/// Amounts are BIGINT minor units in the group's currency (VND: whole đồng). Never floats.
/// Deleting is soft (deletedAt) so balances can be audited. `version` is for optimistic locking.
model Expense {
  id         String    @id @default(uuid(7)) @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  payerId    String    @map("payer_id") @db.Uuid
  amount     BigInt
  currency   Currency
  title      String
  note       String?
  splitType  SplitType @map("split_type")
  /// The calendar day it was spent (no time zone).
  spentOn    DateTime  @map("spent_on") @db.Date
  receiptKey String?   @map("receipt_key")
  createdBy  String    @map("created_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group   Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer   User           @relation("ExpensePayer", fields: [payerId], references: [id])
  creator User           @relation("ExpenseCreator", fields: [createdBy], references: [id])
  splits  ExpenseSplit[]

  @@index([groupId, spentOn(sort: Desc), id(sort: Desc)])
  @@map("expenses")
}

/// One row per person sharing the expense. The amounts always add up to expenses.amount
/// (checked by a deferred constraint trigger in the database, not only in the service).
model ExpenseSplit {
  expenseId String @map("expense_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  amount    BigInt
  /// What was entered: the amount (exact), basis points (percent) or shares. 1 for equal.
  value     Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

/// Append-only audit trail of changes to group data.
model ActivityLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  diff      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([groupId, createdAt])
  @@map("activity_log")
}

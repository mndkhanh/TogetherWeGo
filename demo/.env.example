# Local development: talk to the Firebase emulators (no real project needed).
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-togetherwego

# A real Firebase project (Project settings > Your apps > Web app). These values are
# public by design: Firestore security rules are what protect the data.
# VITE_USE_EMULATORS=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

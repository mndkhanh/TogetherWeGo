{
  "name": "togetherwego-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-togetherwego",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "test": "vitest run tests/money.test.ts",
    "test:rules": "firebase emulators:exec --project demo-togetherwego --only firestore,storage \"vitest run --no-file-parallelism tests/rules.test.ts tests/storage.test.ts\"",
    "test:payments": "npm --prefix functions run build && firebase emulators:exec --project demo-togetherwego --only auth,firestore,functions \"vitest run tests/payments.test.ts\"",
    "functions:build": "npm --prefix functions run build",
    "sepay:simulate": "node scripts/sepay-simulate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firebase:deploy": "pnpm build && firebase deploy --only hosting,firestore,functions,storage"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.37.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}

rules_version = '2';

// TogetherWeGo demo: there is no server, so these rules are the whole backend's access control.
//
//   groups/{groupId}                        name, ownerId, inviteCode, inviteExpiresAt, memberIds, createdAt
//   invites/{code}                          groupId, expiresAt: the short code in a join link, /j/CODE
//   users/{uid}                             name, altName?, photo: your profile (only you read it)
//     members/{uid}                         uid, name, altName?, photo?, role, code, joinedAt
//     expenses/{expenseId}                  description, amount, paidBy, participants, spentOn, createdBy, createdAt,
//                                           and optionally split + weights (uneven), photos (file names in Storage), reference,
//                                           eventId (the plan it was for), editedAt + editedBy, deletedAt + deletedBy
//                                           (deleted ones stay, marked, and count for nothing)
//     payments/{paymentId}                  from, to, amount, note, createdBy, createdAt
//     events/{eventId}                      title, startsAt, location, createdBy, createdAt
//       rsvps/{uid}                         status, name, updatedAt
//     settlements/{settlementId}            from, to, amount, code, status, via, paidAmount, ...
//       private/bank                        the payee's bank details for that payment
//     summary/balances, summary/activity    running balances and the latest change (functions only)
//   paymentAccounts/{uid}                   your bank account and SePay key hash
//   paymentCodes/{code}, sepayTransfers/…   server only
//
// Bank-transfer payments (settlements), bank accounts and SePay are written by Cloud Functions
// (functions/src/index.ts), which run with admin rights and do their own checks. Clients may
// only read them, plus two changes: the payee confirms a payment arrived, and either side
// cancels one that's still pending.
//
// Everything in a group is visible only to its members. Joining needs the group's invite code
// (shared as a link), and the owner can remove members. Amounts are whole VND. Nothing is ever
// updated in place except a group's name, invite code and member list, expenses (by whoever
// added them or paid), events (by whoever created them) and your own RSVP.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid()));
    }

    // Everyone in the group, kept on the group document so one read can check a whole list
    // (rules can't loop). It changes only together with a member document; see below.
    function memberIds(groupId) {
      return get(groupPath(groupId)).data.memberIds;
    }

    function hasExactly(keys) {
      return request.resource.data.keys().hasOnly(keys) && request.resource.data.keys().hasAll(keys);
    }

    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Whole VND, positive, under 10 billion.
    // Up to 4 photo file names, as storage.rules allows them (rules can't loop, hence one by one).
    function photoName(name) {
      return name is string && name.matches('^[a-z0-9-]{1,40}[.](jpg|png|webp)$');
    }

    function photosOk(photos) {
      return photos is list && photos.size() <= 4
        && (photos.size() < 1 || photoName(photos[0]))
        && (photos.size() < 2 || photoName(photos[1]))
        && (photos.size() < 3 || photoName(photos[2]))
        && (photos.size() < 4 || photoName(photos[3]));
    }

    function money(value) {
      return value is int && value > 0 && value <= 10000000000;
    }

    // Your own memberships, in any group: "find my groups" (a collection group query on
    // members where uid == me) and "am I in this one already?" (reading your own document,
    // which may not exist yet).
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && (memberId == uid() || resource.data.uid == uid());
    }

    // Your activity: expenses, payments and bank transfers that involve you, across all your
    // groups in one query each (collection group queries filtered to you). Only entries you're
    // part of, which you could already read in the group itself.
    match /{path=**}/expenses/{expenseId} {
      allow read: if signedIn()
        && (uid() in resource.data.participants || resource.data.paidBy == uid());
    }
    match /{path=**}/payments/{paymentId} {
      allow read: if signedIn() && (resource.data.from == uid() || resource.data.to == uid());
    }
    match /{path=**}/settlements/{settlementId} {
      allow read: if signedIn() && (resource.data.from == uid() || resource.data.to == uid());
    }

    // Only you see your bank account and SePay status. All changes go through functions.
    // An optional second name (nickname or full name) so friends recognise you.
    function altNameOk(data) {
      return !('altName' in data) || text(data.altName, 1, 40);
    }

    // A profile photo: the download link of your own picture in Storage (avatars/{uid}/), never
    // a link to somewhere else. The emulator serves the same paths on 127.0.0.1:9199.
    function photoOk(data) {
      return !('photo' in data) || (data.photo is string && data.photo.size() <= 600
        && data.photo.matches(
          '^(https://firebasestorage[.]googleapis[.]com|http://(127[.]0[.]0[.]1|localhost):9199)'
          + '/v0/b/[a-z0-9._-]+/o/avatars%2F' + uid() + '%2F[a-z0-9-]{1,40}[.]jpg[?]alt=media&token=[a-f0-9-]{1,64}$'));
    }

    // An uneven split: one weight per participant, in the same order, each a positive whole
    // number (shares in halves, or exact dong). Rules can't loop, so each of the 50 places a
    // participant can be in is checked in turn.
    function weightOk(w, i) {
      return i >= w.size() || (w[i] is int && w[i] >= 1 && w[i] <= 10000000000);
    }

    function weightsOk(data) {
      let w = data.weights;
      return w is list && w.size() == data.participants.size()
        && weightOk(w, 0)
        && weightOk(w, 1)
        && weightOk(w, 2)
        && weightOk(w, 3)
        && weightOk(w, 4)
        && weightOk(w, 5)
        && weightOk(w, 6)
        && weightOk(w, 7)
        && weightOk(w, 8)
        && weightOk(w, 9)
        && weightOk(w, 10)
        && weightOk(w, 11)
        && weightOk(w, 12)
        && weightOk(w, 13)
        && weightOk(w, 14)
        && weightOk(w, 15)
        && weightOk(w, 16)
        && weightOk(w, 17)
        && weightOk(w, 18)
        && weightOk(w, 19)
        && weightOk(w, 20)
        && weightOk(w, 21)
        && weightOk(w, 22)
        && weightOk(w, 23)
        && weightOk(w, 24)
        && weightOk(w, 25)
        && weightOk(w, 26)
        && weightOk(w, 27)
        && weightOk(w, 28)
        && weightOk(w, 29)
        && weightOk(w, 30)
        && weightOk(w, 31)
        && weightOk(w, 32)
        && weightOk(w, 33)
        && weightOk(w, 34)
        && weightOk(w, 35)
        && weightOk(w, 36)
        && weightOk(w, 37)
        && weightOk(w, 38)
        && weightOk(w, 39)
        && weightOk(w, 40)
        && weightOk(w, 41)
        && weightOk(w, 42)
        && weightOk(w, 43)
        && weightOk(w, 44)
        && weightOk(w, 45)
        && weightOk(w, 46)
        && weightOk(w, 47)
        && weightOk(w, 48)
        && weightOk(w, 49);
    }

    function splitOk(data) {
      return (!('split' in data) && !('weights' in data))
        || (data.split in ['shares', 'amounts'] && weightsOk(data));
    }

    // Your profile: the name groups see and an optional alternative. Copied onto your member
    // documents when you join or change it, so other members never read this one.
    match /users/{userId} {
      allow read: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasAll(['name', 'photo', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'altName', 'photo', 'updatedAt'])
        && text(request.resource.data.name, 1, 60)
        && altNameOk(request.resource.data)
        && photoOk(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /paymentAccounts/{ownerId} {
      allow read: if signedIn() && ownerId == uid();
      allow write: if false;
    }

    // SePay transfers that reached your account, matched or not.
    match /sepayTransfers/{transferId} {
      allow read: if signedIn() && resource.data.owner == uid();
      allow write: if false;
    }

    match /paymentCodes/{code} {
      allow read, write: if false;
    }

    // A group's invite code is 8 characters (no 0/O, 1/I/L), and points back at its group so a
    // join link can be just /j/CODE. Anyone signed in can look up a code they have; nobody can
    // list them. Only the owner writes one, in the same batch that sets it on the group. It
    // carries the group's expiry so the join page can say a link has run out.
    function inviteCodeShape(code) {
      return code is string && code.matches('^[A-HJKMNP-Z2-9]{8}$');
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn()
        && inviteCodeShape(code)
        && hasExactly(['groupId', 'expiresAt'])
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerId == uid()
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteExpiresAt
          == request.resource.data.expiresAt;
      // Gone once the group has moved on to another code.
      allow delete: if signedIn()
        && get(groupPath(resource.data.groupId)).data.ownerId == uid()
        && getAfter(groupPath(resource.data.groupId)).data.inviteCode != code;
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);

      // The invite code is unchanged, or it's a new one written to invites in the same batch.
      function inviteCodeOk() {
        let code = request.resource.data.inviteCode;
        return (resource != null && code == resource.data.inviteCode)
          || (inviteCodeShape(code)
            && getAfter(/databases/$(database)/documents/invites/$(code)).data.groupId == groupId);
      }

      // Every new code comes with an expiry from now up to 7 days (a little slack for clocks).
      // An unchanged code keeps its expiry: renewing a link means a new code.
      function inviteExpiryOk() {
        let next = request.resource.data.get('inviteExpiresAt', null);
        return (resource != null && request.resource.data.inviteCode == resource.data.inviteCode)
          ? next == resource.data.get('inviteExpiresAt', null)
          : next is timestamp
            && next > request.time
            && next < request.time + duration.value(8, 'd');
      }

      // Created together with the owner's member document, in one batch.
      allow create: if signedIn()
        && hasExactly(['name', 'ownerId', 'inviteCode', 'inviteExpiresAt', 'memberIds', 'createdAt'])
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && text(request.resource.data.name, 1, 80)
        && inviteCodeOk()
        && inviteExpiryOk()
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid()));

      // The owner can rename the group or make a new invite link (the old one stops working).
      allow update: if signedIn()
        && resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'inviteCode', 'inviteExpiresAt'])
        && text(request.resource.data.name, 1, 80)
        && inviteCodeOk()
        && inviteExpiryOk()
      // Joining adds just you to memberIds, in the same batch as your member document (whose
      // own rule checks the invite code).
      || signedIn()
        && !(uid() in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([uid()])
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid()))
      // The owner removes one member (never themselves): out of memberIds, their member document
      // deleted in the same batch, and a new invite code so the old link can't bring them back.
      || signedIn()
        && resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'inviteCode', 'inviteExpiresAt'])
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.inviteCode != resource.data.inviteCode
        && inviteCodeOk()
        && inviteExpiryOk()
        && !existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(
          resource.data.memberIds.removeAll(request.resource.data.memberIds)[0]));

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(groupId);

        // You can only add yourself: as the owner while creating the group, or with the
        // invite code. Rules read the group directly, so a non-member never sees it.
        allow create: if signedIn()
          && memberId == uid()
          && request.resource.data.keys().hasAll(['uid', 'name', 'role', 'code', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['uid', 'name', 'altName', 'photo', 'role', 'code', 'joinedAt'])
          && request.resource.data.uid == uid()
          && text(request.resource.data.name, 1, 60)
          && altNameOk(request.resource.data)
          && photoOk(request.resource.data)
          && request.resource.data.joinedAt == request.time
          && (
            (request.resource.data.role == 'owner'
              && getAfter(groupPath(groupId)).data.ownerId == uid()
              && request.resource.data.code == getAfter(groupPath(groupId)).data.inviteCode)
            || (request.resource.data.role == 'member'
              && request.resource.data.code == get(groupPath(groupId)).data.inviteCode
              // Links from before expiry existed have none; every newer one runs out.
              && request.time < get(groupPath(groupId)).data.get('inviteExpiresAt', request.time + duration.value(1, 's'))
              && uid() in getAfter(groupPath(groupId)).data.memberIds)
          );

        // You can change how you appear: your names and photo, nothing else.
        allow update: if signedIn()
          && memberId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'altName', 'photo'])
          && text(request.resource.data.name, 1, 60)
          && altNameOk(request.resource.data)
          && photoOk(request.resource.data);

        // Only the owner removes someone, together with the group update above. Their past
        // expenses and payments stay, so the group's balances don't change.
        allow delete: if signedIn()
          && memberId != uid()
          && get(groupPath(groupId)).data.ownerId == uid()
          && !(memberId in getAfter(groupPath(groupId)).data.memberIds);
      }

      match /expenses/{expenseId} {
        allow read: if isMember(groupId);

        // What any expense must be, new or edited. Any member can record what any member paid
        // (a friend often logs the bill for whoever paid it). Split equally between
        // participants, or by their weights (computed the same way by every client,
        // src/shared/money.ts), who must all be in the group.
        function expenseOk(d) {
          return d.keys().hasAll(['description', 'amount', 'paidBy', 'participants', 'spentOn', 'createdBy', 'createdAt'])
            && d.keys().hasOnly(['description', 'amount', 'paidBy', 'participants', 'split', 'weights', 'spentOn', 'createdBy', 'createdAt', 'photos', 'reference', 'eventId', 'editedAt', 'editedBy', 'deletedAt', 'deletedBy'])
            && photosOk(d.get('photos', []))
            && (!('reference' in d) || text(d.reference, 1, 300))
            && text(d.description, 1, 120)
            && money(d.amount)
            && d.paidBy is string
            && d.paidBy in memberIds(groupId)
            && d.participants is list
            && d.participants.size() >= 1
            && d.participants.size() <= 50
            && d.participants.toSet().size() == d.participants.size()
            && memberIds(groupId).hasAll(d.participants)
            && splitOk(d)
            // Optionally for one of this group's plans.
            && (!('eventId' in d)
              || (d.eventId is string
                && exists(/databases/$(database)/documents/groups/$(groupId)/events/$(d.eventId))))
            && d.spentOn is string
            && d.spentOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }

        // Everyone it's about is still in the group: changing it would move money for someone
        // who has left, and nobody could settle that with them.
        function everyoneStillIn(d) {
          return d.paidBy in memberIds(groupId) && memberIds(groupId).hasAll(d.participants);
        }

        function notDeleted(d) {
          return !('deletedAt' in d) && !('deletedBy' in d);
        }

        // Fixing it: the same checks as a new one; who added it, when, and its photos stay.
        function editing() {
          let d = request.resource.data;
          return notDeleted(resource.data) && notDeleted(d)
            && expenseOk(d)
            && d.createdBy == resource.data.createdBy
            && d.createdAt == resource.data.createdAt
            && d.get('photos', []) == resource.data.get('photos', [])
            && d.editedAt == request.time
            && d.editedBy == uid();
        }

        // Deleting it: only marked, saying who and when, so the group sees it and it can be
        // brought back. Nothing else changes.
        function deleting() {
          let d = request.resource.data;
          return notDeleted(resource.data)
            && d.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
            && d.deletedAt == request.time
            && d.deletedBy == uid()
            && everyoneStillIn(resource.data);
        }

        // Bringing it back, as it was; it then counts as edited by whoever did.
        function restoring() {
          let d = request.resource.data;
          return 'deletedAt' in resource.data
            && notDeleted(d)
            && d.diff(resource.data).affectedKeys()
              .hasOnly(['deletedAt', 'deletedBy', 'editedAt', 'editedBy'])
            && d.editedAt == request.time
            && d.editedBy == uid()
            && everyoneStillIn(resource.data);
        }

        allow create: if isMember(groupId)
          && expenseOk(request.resource.data)
          && notDeleted(request.resource.data)
          && !('editedAt' in request.resource.data)
          && !('editedBy' in request.resource.data)
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time;

        // Whoever added it, or the person it says paid (if they didn't, or it's wrong), can fix,
        // delete or bring it back.
        allow update: if isMember(groupId)
          && (resource.data.createdBy == uid() || resource.data.paidBy == uid())
          && (editing() || deleting() || restoring());

        // Never erased: a deleted expense stays, marked, with its photos.
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isMember(groupId);

        // Cash and other payments outside the app: only the person who was paid records it.
        // If the payer could, they could wipe out their own debt, or invent one the other way.
        allow create: if isMember(groupId)
          && hasExactly(['from', 'to', 'amount', 'note', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && request.resource.data.to == uid()
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.from in memberIds(groupId)
          && money(request.resource.data.amount)
          && text(request.resource.data.note, 0, 120);

        allow update: if false;
        allow delete: if isMember(groupId) && resource.data.createdBy == uid();
      }

      // Running balances and the latest change, kept by the functions (functions/src/index.ts).
      match /summary/{docId} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isMember(groupId);
        allow create, delete: if false;

        // The payee says the money arrived (SePay does the same through the webhook).
        allow update: if isMember(groupId)
          && resource.data.status == 'pending'
          && resource.data.to == uid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'via', 'paidAmount', 'confirmedAt'])
          && request.resource.data.status == 'confirmed'
          && request.resource.data.via == 'payee'
          && request.resource.data.paidAmount == resource.data.amount
          && request.resource.data.confirmedAt == request.time
        // Either side calls off a payment that hasn't been confirmed.
        || isMember(groupId)
          && resource.data.status == 'pending'
          && (resource.data.from == uid() || resource.data.to == uid())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled';

        // Bank details: only the two people in this payment.
        match /private/{doc} {
          allow read: if signedIn() && (resource.data.from == uid() || resource.data.to == uid());
          allow write: if false;
        }
      }

      match /events/{eventId} {
        allow read: if isMember(groupId);

        allow create: if isMember(groupId)
          && hasExactly(['title', 'startsAt', 'location', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time
          && text(request.resource.data.title, 1, 100)
          && request.resource.data.startsAt is timestamp
          && text(request.resource.data.location, 0, 200);

        allow update: if isMember(groupId)
          && resource.data.createdBy == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'startsAt', 'location'])
          && text(request.resource.data.title, 1, 100)
          && request.resource.data.startsAt is timestamp
          && text(request.resource.data.location, 0, 200);

        allow delete: if isMember(groupId) && resource.data.createdBy == uid();

        match /rsvps/{memberId} {
          allow read: if isMember(groupId);

          allow create, update: if isMember(groupId)
            && memberId == uid()
            && exists(/databases/$(database)/documents/groups/$(groupId)/events/$(eventId))
            && hasExactly(['status', 'name', 'updatedAt'])
            && request.resource.data.status in ['going', 'maybe', 'no']
            && text(request.resource.data.name, 1, 60)
            && request.resource.data.updatedAt == request.time;

          allow delete: if false;
        }
      }
    }
  }
}
